# Supabase (required for auth + data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role — server only. Required for Settings → Delete account.
# Never expose this in client bundles or commit real values.
# Vercel: Project → Settings → Environment Variables → Production (+ Preview if needed)
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (optional until AI routes are used: goal plan, meal estimate, weekly review)
# Build succeeds without these; AI buttons return a clear 503 if missing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App is served under basePath /goal (see next.config.js). Override only if you change that.
# NEXT_PUBLIC_BASE_PATH=/goal

# Local screenshot / E2E fixtures only. Never set in Vercel production.
# (Also hard-disabled when NODE_ENV=production.)
# NEXT_PUBLIC_VISUAL_REVIEW=1
